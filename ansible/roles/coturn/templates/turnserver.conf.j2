# Managed by Ansible (coturn role) — do not edit by hand.
#
# Deliberately NOT the full upstream stock config: no unused database
# backends, no CLI (disabled below, one less credential to leak), no
# commented-out options nobody's reviewing every deploy. See
# github.com/coturn/coturn's own turnserver.conf.default upstream if
# you need a directive this file doesn't set.

listening-port=3478
tls-listening-port=5349

min-port={{ coturn_min_port }}
max-port={{ coturn_max_port }}

fingerprint
realm={{ coturn_realm }}

{% if coturn_auth_mode == "secret" %}
lt-cred-mech
use-auth-secret
static-auth-secret={{ coturn_static_auth_secret }}
{% else %}
lt-cred-mech
user={{ coturn_static_username }}:{{ coturn_static_password }}
{% endif %}

{% if coturn_external_public_ip and coturn_external_private_ip %}
# NAT/CGNAT address mapping — see defaults/main.yml.
external-ip={{ coturn_external_public_ip }}/{{ coturn_external_private_ip }}
{% endif %}

cert=/etc/coturn/cert.pem
pkey=/etc/coturn/privkey.pem

# CLI disabled entirely rather than templating yet another credential
# (cli-password) this role has no other use for. Re-enable by hand
# (cli-ip/cli-port/cli-password) if you actually need runtime CLI
# access — see the upstream default config for the directives.
no-cli

syslog
