---
x-authentik-env: &authentik-env
  AUTHENTIK_SECRET_KEY: "{{ authentik_secret_key }}"
  AUTHENTIK_REDIS__HOST: redis
  AUTHENTIK_POSTGRESQL__HOST: "{{ authentik_postgres_host }}"
  AUTHENTIK_POSTGRESQL__PORT: "{{ authentik_postgres_port }}"
  AUTHENTIK_POSTGRESQL__NAME: "{{ authentik_postgres_database }}"
  AUTHENTIK_POSTGRESQL__USER: "{{ authentik_postgres_user }}"
  AUTHENTIK_POSTGRESQL__PASSWORD: "{{ authentik_postgres_password }}"
  AUTHENTIK_BOOTSTRAP_PASSWORD: "{{ authentik_bootstrap_password }}"
  AUTHENTIK_BOOTSTRAP_TOKEN: "{{ authentik_bootstrap_token }}"
{% if authentik_s3_enabled %}
  AUTHENTIK_STORAGE__MEDIA__BACKEND: "s3"
  AUTHENTIK_STORAGE__MEDIA__S3__ACCESS_KEY: "{{ authentik_s3_access_key }}"
  AUTHENTIK_STORAGE__MEDIA__S3__SECRET_KEY: "{{ authentik_s3_secret_key }}"
  AUTHENTIK_STORAGE__MEDIA__S3__BUCKET_NAME: "{{ authentik_s3_bucket }}"
  AUTHENTIK_STORAGE__MEDIA__S3__ENDPOINT: "{{ authentik_s3_endpoint }}"
  AUTHENTIK_STORAGE__MEDIA__S3__REGION: "{{ authentik_s3_region }}"
{% endif %}

services:
  redis:
    image: "{{ authentik_redis_image }}"
    container_name: authentik-redis
    restart: unless-stopped
    # No RDB snapshots, no AOF — purely in-memory. Container restart
    # wipes cache + broker queue, which is fine for this role's stated
    # trade-off (see defaults/main.yml).
    command: --save "" --appendonly "no"
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      interval: 30s
      timeout: 3s
      retries: 5

  server:
    image: "ghcr.io/goauthentik/server:{{ authentik_version }}"
    container_name: authentik-server
    restart: unless-stopped
    command: server
    environment:
      <<: *authentik-env
    volumes:
      - authentik-media:/media
      - authentik-templates:/templates
      - authentik-certs:/certs
    ports:
      - "{{ authentik_http_port }}:9000"
    depends_on:
      - redis

  worker:
    image: "ghcr.io/goauthentik/server:{{ authentik_version }}"
    container_name: authentik-worker
    restart: unless-stopped
    command: worker
    environment:
      <<: *authentik-env
    volumes:
      - authentik-media:/media
      - authentik-templates:/templates
      - authentik-certs:/certs
    depends_on:
      - redis

volumes:
  authentik-media:
    name: authentik-media
  authentik-templates:
    name: authentik-templates
  authentik-certs:
    name: authentik-certs
