# Copy to .env and fill in real values. Never commit the real .env file.

# --- Google service account + domain-wide delegation ---
# No browser, no consent screen, no expiring token. Requires:
#   1. A service account created in Google Cloud Console
#      (IAM & Admin -> Service Accounts), with a downloaded JSON key.
#   2. That service account's numeric Client ID (on its details page --
#      NOT its email address) authorized for domain-wide delegation in
#      the Workspace Admin console: admin.google.com -> Security ->
#      Access and data control -> API Controls -> Domain-wide Delegation
#      -> Add new -> scope: https://www.googleapis.com/auth/calendar.readonly
#   3. The Google Calendar API enabled on that Cloud project.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/PATH/TO/KEYFILE/service-account.json

# The Workspace user this script impersonates. Must be a real mailbox in
# a domain you administer -- this is what lets it see that user's full
# calendarList (their own calendar plus anything already shared into it).
GOOGLE_IMPERSONATE_SUBJECT=user1@example.com

# Comma-separated list of Google Calendar IDs to pull free/busy from.
# For your own calendars this is just the email address. For calendars
# shared into this account, use the same ID shown in calendarList.list()
# (usually the owner's email address).
GOOGLE_CALENDAR_IDS=user1@example.com,user2@example.com

# How many days ahead to pull busy blocks for.
SYNC_LOOKAHEAD_DAYS=90

# IANA zone name -- decides where local midnight falls for the sync's
# query-window floor (see floor_to_local_day() in the script). Resolved
# via Python's stdlib zoneinfo, so DST is handled automatically -- don't
# use a fixed UTC offset here. Defaults to UTC if unset.
SYNC_TIMEZONE=America/New_York

# --- Nextcloud CalDAV target ---
# Base server URL (used for auth/discovery).
NEXTCLOUD_BASE_URL=https://drive.example.com/remote.php/dav/

# Full direct URL to the specific target calendar collection.
# Find this via the calendar's Share/sharing-info panel in Nextcloud, or:
# https://drive.gooseops.com/remote.php/dav/calendars/<username>/<calendar-name>/
NEXTCLOUD_CALENDAR_URL=https://drive.example.com/remote.php/dav/calendars/goose/example-calendar/

NEXTCLOUD_USERNAME=goose
# Generate under Nextcloud -> Personal Settings -> Security -> Devices & Sessions
# Use a dedicated app password for this script, not one shared with other apps.
NEXTCLOUD_APP_PASSWORD=your-nextcloud-app-password

# --- Bookkeeping ---
# Prefix used when generating new UIDs. UIDs are never derived from
# content and never reused -- see the state file below.
SYNC_UID_PREFIX=freebusy-sync-

# Local file mapping this script's own busy-block bookkeeping to the
# actual UIDs written to Nextcloud. Keep this alongside the script, not
# in a temp directory that might get cleared -- losing it means the
# script won't recognize previously-written blocks and will recreate
# them under fresh UIDs, orphaning the old ones on the server.
SYNC_STATE_PATH=/PATH/TO/STATE/sync_state.json

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
