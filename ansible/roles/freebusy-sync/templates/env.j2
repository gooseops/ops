# Managed by Ansible (freebusy-sync role) — do not edit by hand.
# Read via python-dotenv's default cwd-search behavior — the systemd
# unit sets WorkingDirectory to this file's directory, so the script
# picks it up with no extra flag needed (matches how the script is
# already designed to run, see .env.example).

GOOGLE_SERVICE_ACCOUNT_KEY_PATH={{ freebusy_sync_install_dir }}/service-account.json
GOOGLE_IMPERSONATE_SUBJECT={{ freebusy_sync_google_impersonate_subject }}
GOOGLE_CALENDAR_IDS={{ freebusy_sync_google_calendar_ids | join(',') }}
SYNC_LOOKAHEAD_DAYS={{ freebusy_sync_lookahead_days }}
SYNC_TIMEZONE={{ freebusy_sync_timezone }}

NEXTCLOUD_BASE_URL={{ freebusy_sync_nextcloud_base_url }}
NEXTCLOUD_CALENDAR_URL={{ freebusy_sync_nextcloud_calendar_url }}
NEXTCLOUD_USERNAME={{ freebusy_sync_nextcloud_username }}
NEXTCLOUD_APP_PASSWORD={{ freebusy_sync_nextcloud_app_password }}

SYNC_UID_PREFIX={{ freebusy_sync_uid_prefix }}
SYNC_STATE_PATH={{ freebusy_sync_state_path }}
LOG_LEVEL={{ freebusy_sync_log_level }}
